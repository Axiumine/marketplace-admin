      >
        <path
          d="M12 5v14"
        />
        <path
          d="M5 12h14"
        />
      </svg>
    </button>
  </div>
  <p
    class="text-tip mb-2 text-sm"
  >
    Register a company first: every shop names one.
  </p>
  <p
    class="text-tip"
  >
    No shop registered.
  </p>
  <div
    class="mt-8 flex items-center justify-end gap-4"
  >
    <button
      class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-box py-2 text-sm font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-50 bg-third text-palette-white hover:bg-pomodoro px-[30px]"
      disabled=""
      type="button"
    >
      Save
    </button>
  </div>
</main>
`;
